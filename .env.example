# ============================================================
# Orveon Platform — Environment Variables (نموذج)
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى Git.
# ============================================================

# --- قاعدة البيانات (MySQL عبر XAMPP) ---
# الصيغة: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# الإعداد الافتراضي في XAMPP: المستخدم root بدون كلمة مرور على المنفذ 3306
DATABASE_URL="mysql://root:@localhost:3306/orveon"

# --- المصادقة / الجلسات (تُستخدم في المرحلة 2) ---
# مفتاح سري لتوقيع الجلسات — 32 حرفاً على الأقل (يرفض الخادم الإقلاع في الإنتاج بسر أقصر).
# ولّده بأمر:  openssl rand -base64 48
# أو:          node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- إعدادات عامة للتطبيق ---
NEXT_PUBLIC_APP_NAME="Orvion"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- تكاملات خارجية (تُفعّل في مراحل لاحقة، اتركها فارغة الآن) ---
# واتساب (المرحلة 8)
WHATSAPP_PROVIDER=""        # cloud | twilio | wa-link
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# بوابة الدفع (المرحلة 5)
PAYMENT_PROVIDER=""         # يُحدّد لاحقاً
PAYMENT_API_KEY=""
